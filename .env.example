# Cổng Express Web Server (API Health check)
PORT=3000

# Đường dẫn file SQLite Database
DATABASE_URL="file:./dev.db"

# API lấy lịch học sinh viên LHU
LHU_API_URL=""

# Thời gian hoãn giữa 2 tin nhắn Zalo (tối thiểu 1500ms để chống ban tài khoản)
ZALO_SEND_DELAY_MS=1500

# Token / Credentials Zalo Bot (Điền Token Bot Zalo của bạn vào đây)
ZALO_BOT_TOKEN=your_zalo_bot_token_here
ZALO_BOT_LANG=vi

# Mức độ ghi log (info, warn, error, debug)
LOG_LEVEL="info"
