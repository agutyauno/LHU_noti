# Cổng Express Web Server (API Health check)
PORT=3000

# Chế độ chạy Bot: "polling" (Mặc định cho Local test) hoặc "webhook" (Cho Production)
BOT_MODE="polling"

# Khoảng thời gian Polling hỏi tin nhắn mới (Tính bằng ms, mặc định 3000ms = 3 giây)
BOT_POLL_INTERVAL_MS=3000

# URL Webhook Public (Nếu chạy Webhook mode, ví dụ: https://xxx.ngrok-free.app/api/zalo-webhook)
ZALO_WEBHOOK_URL=""
ZALO_WEBHOOK_SECRET=""

# Đường dẫn file SQLite Database
DATABASE_URL="file:./dev.db"

# API lấy lịch học sinh viên LHU
LHU_API_URL=""

# Thời gian hoãn giữa 2 tin nhắn Zalo
ZALO_SEND_DELAY_MS=1500

# Token / Credentials Zalo Bot
ZALO_BOT_TOKEN="your_zalo_bot_token_here"

# Bật dữ liệu Mock giả lập LHU API cho mục đích Test: "true" hoặc "false"
USE_MOCK="false"

# Giả lập biến động lịch (đổi phòng/giờ) khi USE_MOCK="true" để test Diff Scanner: "true" hoặc "false"
MOCK_DIFF="false"

# Mức độ ghi log (info, warn, error, debug)
LOG_LEVEL="info"
